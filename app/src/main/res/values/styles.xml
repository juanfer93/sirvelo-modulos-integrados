<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BotonPersonalizado">
        <item name="android:backgroundTint">#B1361C</item> <!-- Color naranja Sírvelo -->
        <item name="android:textColor">#FFFFFF</item> <!-- Texto blanco -->
    </style>

    <style name="BotonSirvelo">
        <item name="android:background">@color/color_corporativo_sirvelo</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextoEncabezadoSirvelo">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_texto_encabezado</item>
    </style>

</resources>